# REAK.Api environment variables (spec §29 — never commit real values here or anywhere else).
# ASP.NET Core reads these from real OS environment variables, `dotnet user-secrets`, or your
# process manager's env config — this file is documentation of what's needed, not something the
# app loads directly. Names use the standard ASP.NET Core "__" nesting convention.

# Required. JWT signing key — the app fails fast at startup if this is unset. Use a long, random
# value (e.g. `openssl rand -base64 48`), never a guessable default.
REAK_JWT_KEY=

# Required. Resend API key — the app fails fast at startup if this is unset (same pattern as
# REAK_JWT_KEY). Get one from https://resend.com after creating an account.
REAK_RESEND_API_KEY=

# Optional. The "from" address invitation/password-reset emails are sent from. Must be on a
# domain verified with Resend. Defaults to Resend's own unverified-sender testing address
# (onboarding@resend.dev), which sends real mail with no domain setup — fine for a demo, replace
# with your own verified domain before sending to real users at any volume.
REAK_EMAIL_FROM=

# Optional — defaults to http://localhost:3000 (also set in appsettings.json). The frontend's
# public base URL, used to build real clickable links in invitation/password-reset emails
# (e.g. {REAK_FRONTEND_BASE_URL}/invite/{token}). Set this to your real deployed frontend URL in
# any environment other than local dev.
REAK_FRONTEND_BASE_URL=

# Optional — bootstraps a single SuperAdmin account on first run if both are set and no SuperAdmin
# exists yet. Leave unset after the first real admin exists.
REAK_BOOTSTRAP_ADMIN_EMAIL=
REAK_BOOTSTRAP_ADMIN_PASSWORD=

# Optional — all have safe defaults in appsettings.json; override only if you need something else.
# Jwt__Issuer=REAK.Api
# Jwt__Audience=REAK.Clients
# Jwt__AccessTokenMinutes=15
# Jwt__RefreshTokenDays=30
# Storage__LocalRoot=App_Data/storage
# Storage__PublicUrlBase=/media
# ConnectionStrings__DefaultConnection=Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=real-estate;Integrated Security=True;Encrypt=True;TrustServerCertificate=True
