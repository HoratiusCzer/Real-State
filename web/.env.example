# REAK web (Next.js) environment variables (spec §29 — never commit real values). Copy to
# .env.local (already gitignored) for local development.

# Server-only — REAK.Api's base URL. Never exposed to the browser (no NEXT_PUBLIC_ prefix); every
# call to it happens in Server Components/Route Handlers, never client-side JS.
REAK_API_URL=http://localhost:5080

# Public — the canonical site URL used for sitemap.xml/robots.txt/absolute Open Graph URLs (spec
# §26 SEO). Safe to expose to the browser.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
